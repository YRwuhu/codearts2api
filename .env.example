CODEARTS_AK=你的AccessKey
CODEARTS_SK=你的SecretKey

# 纯文本模型收到图片时回退的视觉模型（默认 deepseek-v4.1-flash-1017，off 关闭回退）
# CODEARTS_VISION_MODEL=deepseek-v4.1-flash-1017

# 额外声明支持原生识图的模型（逗号分隔），新模型不用改代码
# CODEARTS_EXTRA_VISION_MODELS=my-new-vl-model
# 提示词清洗：改写会被上游 WAF 误判的 ZCode 注入片段（默认开启）
# CODEARTS_SANITIZE=0
# CODEARTS_SANITIZE_RULES=sanitize.json

# 多账号选号策略：balanced（负载均衡，默认）/ credit（余额优先）/ roundrobin（严格轮转）
# 面板「账号 → 轮换策略」也能改，会写进 rotation.json 并即时生效
# CODEARTS_ROTATION=balanced
# 剩余 credit 低于该值的账号降级为兜底，0 = 不启用
# CODEARTS_MIN_CREDIT=0
